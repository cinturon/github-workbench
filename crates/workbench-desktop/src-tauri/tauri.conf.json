{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Workflow Workbench",
  "version": "0.1.0",
  "identifier": "dev.github-workflow-workbench.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitHub Workflow Workbench",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
